# TravelSphere risk-intelligence service — PLACEHOLDERS ONLY. Copy to risk-service/.env (git-ignored).
RISK_ENV=development
RISK_HOST=127.0.0.1          # keep on loopback/private network; Express is the public entry point
RISK_PORT=8001

# Same database as the Express API (local Postgres or the Supabase connection string)
DATABASE_URL=postgres://localhost:5432/travelsphere_dev

# Shared secret; must equal RISK_SERVICE_TOKEN in server/.env. Required when not on loopback and in production.
#   openssl rand -hex 32
RISK_SERVICE_TOKEN=

# Run background jobs (reassessment, alert expiry, location purge, hazard archive refresh) in ONE instance only
RISK_SCHEDULER_ENABLED=false
RISK_HTTP_TIMEOUT_S=20

# Optional self-hosted providers (the public demo servers have fair-use limits and no SLA)
OSRM_DRIVING_URL=
OSRM_FOOT_URL=
OVERPASS_URLS=
