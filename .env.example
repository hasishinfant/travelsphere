# Frontend (Vite) environment — PLACEHOLDERS ONLY. Copy to .env.
# Anything prefixed VITE_ is compiled into the public JavaScript bundle:
# never put secrets (API keys, passwords, service-role keys) in VITE_ variables.

# Backend API (the Vite dev server proxies /api to the Express server on :4000)
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT=30000


