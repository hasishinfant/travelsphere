# Frontend (Vite) environment — PLACEHOLDERS ONLY. Copy to .env.
# Anything prefixed VITE_ is compiled into the public JavaScript bundle:
# never put secrets (API keys, passwords, service-role keys) in VITE_ variables.

# Backend API (the Vite dev server proxies /api to the Express server on :4000)
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT=30000

# Supabase public client settings (anon key is designed to be public; RLS protects data)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# DEPRECATED — TBO/TekTravels credentials must move to the server (they are secrets).
# The browser clients still read these until the TBO integration is proxied by the backend.
VITE_TEK_TRAVELS_API_KEY=your_tek_travels_api_key_here
VITE_TEK_TRAVELS_API_URL=https://api.tektravels.com/BookingEngineService_Air/AirService.svc/rest
