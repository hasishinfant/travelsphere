# TravelSphere API server — PLACEHOLDERS ONLY. Copy to server/.env (git-ignored).
NODE_ENV=development
PORT=4000

# Local Postgres for development, or the Supabase connection string in production
# (Supabase dashboard → Project Settings → Database → Connection string).
DATABASE_URL=postgres://localhost:5432/travelsphere_dev

# local    = development sign-in issued by this server (refused when NODE_ENV=production)
# supabase = verify Supabase Auth JWTs
AUTH_MODE=local
LOCAL_JWT_SECRET=replace-with-32-plus-random-characters

# Required when AUTH_MODE=supabase (JWKS is used when SUPABASE_URL is set)
SUPABASE_URL=https://your-project-ref.supabase.co
# Legacy projects only (Project Settings → API → JWT secret)
SUPABASE_JWT_SECRET=

CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Python risk-intelligence service (internal). Token must match risk-service/.env; required in production.
RISK_SERVICE_URL=http://127.0.0.1:8001
RISK_SERVICE_TOKEN=
RISK_SERVICE_TIMEOUT_MS=120000
# Destination assessments younger than this (minutes) are served from the database
ASSESSMENT_MAX_AGE_MIN=30

# Hotel inventory (LiteAPI / Nuitée). Free sandbox key: https://connect.nuitee.com → Developer tools.
# sandbox = simulated bookings, nothing is charged. production bookings are billed to the LiteAPI account and stay
# disabled unless LITEAPI_ALLOW_LIVE_BOOKINGS=true.
LITEAPI_API_KEY=
LITEAPI_ENV=sandbox
LITEAPI_ALLOW_LIVE_BOOKINGS=false

# Firebase Cloud Messaging HTTP v1 (optional; without it risk warnings are in-app only)
FCM_PROJECT_ID=
# Service-account key JSON on one line (role: Firebase Cloud Messaging API Admin). Never commit it.
FCM_SERVICE_ACCOUNT_JSON=


# TLS: on macOS the system root certificates are added to Node's trust store automatically
# (set USE_SYSTEM_TRUST_STORE=false to disable). Elsewhere, point TRUSTED_CA_FILE at a PEM bundle.
TRUSTED_CA_FILE=
